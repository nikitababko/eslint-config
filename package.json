{
  "name": "@nikitababko/eslint-config",
  "version": "0.1.0",
  "type": "module",
  "types": "./configs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./configs/index.d.ts",
      "default": "./configs/index.js"
    },
    "./base": {
      "types": "./configs/base.d.ts",
      "default": "./configs/base.js"
    },
    "./typescript": {
      "types": "./configs/typescript.d.ts",
      "default": "./configs/typescript.js"
    },
    "./vanilla": {
      "types": "./configs/vanilla.d.ts",
      "default": "./configs/vanilla.js"
    },
    "./react": {
      "types": "./configs/react.d.ts",
      "default": "./configs/react.js"
    },
    "./solid": {
      "types": "./configs/solid.d.ts",
      "default": "./configs/solid.js"
    }
  },
  "files": [
    "configs",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "typescript",
    "react",
    "solid"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikitababko/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/nikitababko/eslint-config/issues"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.5.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.3.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-solid": {
      "optional": true
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "commitizen.config.cjs"
    }
  },
  "scripts": {
    "commit": "cz",
    "examples:build": "pnpm -r --filter \"example-*\" build",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm exec tsc -p tsconfig.typecheck.json",
    "test": "pnpm test:unit && pnpm examples:build",
    "test:minimum": "node scripts/test-minimum-versions.js",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  }
}
